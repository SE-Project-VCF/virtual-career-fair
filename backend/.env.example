# Stream Chat API Configuration
# Get these from your Stream Chat dashboard: https://dashboard.getstream.io/
STREAM_API_KEY=your-stream-api-key-here
STREAM_API_SECRET=your-stream-api-secret-here

# Admin Account Creation Secret Key
# Generate a secure random string (e.g., using: openssl rand -hex 32)
ADMIN_SECRET_KEY=your-super-secret-admin-key-here-change-this

# PORT for Express server
PORT=5002

# Mapbox Geocoding (server-side only; career fair venue addresses)
MAPBOX_ACCESS_TOKEN=

# Frontend URL for CORS (required for deployed environments)
FRONTEND_URL=http://localhost:5173

# Invite Code Encryption Secret (32 bytes = 64 hex chars)
# Generate with: openssl rand -hex 32
INVITE_CODE_SECRET=your-invite-code-secret-here-replace-with-64-hex-chars

# Gemini API Key for AI features
GEMINI_API_KEY=your-gemini-api-key-here

# Mapbox Access Token for map features
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here
